! Example KIM configuration with adaptive QUADPACK theta integration.
! Physics setup as in KIM_config.nml; only the KIM_GRID integration settings
! differ. All physical quantities in cgs units.

&KIM_CONFIG
    type_of_run = 'electrostatic'
    collision_model = 'FokkerPlanck'
    number_of_ion_species = 1
    read_species_from_namelist = .false.
    plasma_type = 'D'
    turn_off_ions = .false.
    turn_off_electrons = .false.
    artificial_debye_case = 0
    rescale_density = .false.
    number_density_rescale = 1d-6
    ion_flr_scale_factor = 1.0
/

! Required group, unused by this run type
&WKB_DISPERSION
/

&KIM_IO
    profile_location = './profiles/'
    output_path = './out/'
    hdf5_input = .false.
    hdf5_output = .true.
    h5_out_file = 'KIM_output.h5'
    log_level = 3
    data_verbosity = 1
    calculate_asymptotics = .false.
/

&KIM_SETUP
    btor = -17977.413
    R0 = 165.0
    m_mode = -6
    n_mode = 2
    omega = 0.0
    spline_base = 1
    type_br_field = 12
    collisions_off = .false.
    set_profiles_constant = 0
    bc_type = 3
    mphi_max = 0
/

&KIM_GRID
    r_min = 3.0
    r_plas = 67.0
    width_res = 0.5
    ampl_res = 15.0
    hrmax_scaling = 1.0
    l_space_dim = 512
    rg_space_dim = 512
    grid_spacing_rg = 'equidistant'
    grid_spacing_xl = 'equidistant'

    ! 'QUADPACK' selects the adaptive QUADPACK path; theta_integration_method
    ! is set automatically and need not be given.
    theta_integration = 'QUADPACK'

    quadpack_algorithm = 'QAG'            ! 'QAG' or 'QAGS'
    quadpack_key = 6                      ! QAG Gauss-Kronrod rule: 1-6 for QK15-QK61
    quadpack_limit = 500                  ! maximum number of subdivisions
    quadpack_epsabs = 1.0d-10             ! absolute tolerance
    quadpack_epsrel = 1.0d-10             ! relative tolerance
    quadpack_use_u_substitution = .true.  ! integrate in u = sin(theta/2)

    gauss_int_nodes_Nx = 31
    gauss_int_nodes_Nxp = 30
    gauss_int_nodes_Ntheta = 17           ! used only by GaussLegendre

    Larmor_skip_factor = 5
    kernel_taper_skip_threshold = 1.0d-6
/

&KIM_PROFILES
    coord_type = 'auto'
/

! Notes on QUADPACK configuration:
!
! quadpack_algorithm:
!   - 'QAG': General-purpose adaptive integration (recommended for most cases)
!   - 'QAGS': Adaptive integration with singularities at endpoints
!
! quadpack_key (Gauss-Kronrod rule selection, QAG only):
!   - 1: QK15 (7-15 points) - Fast but less accurate
!   - 2: QK21 (10-21 points)
!   - 3: QK31 (15-31 points)
!   - 4: QK41 (20-41 points)
!   - 5: QK51 (25-51 points)
!   - 6: QK61 (30-61 points) - Slow but most accurate (recommended)
!
! quadpack_limit:
!   - Maximum number of subintervals in adaptive subdivision
!   - Increase if integration fails to converge
!   - Higher values allow better handling of difficult integrands
!
! quadpack_use_u_substitution:
!   - Recommended for integrands with sin(theta) in denominator
!   - Transforms theta integral to u=sin(theta/2) for better numerical stability
