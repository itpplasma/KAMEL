# Writes a Fortran include with the git commit of SOURCE_DIR, "-dirty" appended if
# tracked files differed from it when the build ran. Script mode, run on every
# build by the ql-balance_git_version target:
#
#   cmake -DSOURCE_DIR=<repository> -DOUTPUT=<file.inc> -P WriteGitVersion.cmake
#
# OUTPUT is replaced only when its content changes, so a build at the same commit
# and dirty state recompiles nothing.

set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    # --exclude=*: the full hash, never a tag-relative name such as golden-baseline-5-g...
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}"
                describe --always --dirty --abbrev=40 --exclude=*
        OUTPUT_VARIABLE describe
        RESULT_VARIABLE result
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(result EQUAL 0)
        set(commit "${describe}")
    endif()
endif()

file(WRITE "${OUTPUT}.tmp"
"! Generated by cmake/WriteGitVersion.cmake at build time. Do not edit.
character(len=*), parameter :: git_commit = \"${commit}\"
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
