! KIM tutorial: global electrostatic response with Fokker-Planck collisions.
! Small demonstration case that runs in about a second; it is not a converged
! physics result. All quantities are in CGS units. Every option is described in
! KIM/nmls/README.md.

&kim_config
    number_of_ion_species = 1
    read_species_from_namelist = .false.   ! use the built-in single-ion plasma
    plasma_type = 'D'                      ! deuterium
    type_of_run = 'electrostatic'
    collision_model = 'FokkerPlanck'
    artificial_debye_case = 0
    turn_off_ions = .false.
    turn_off_electrons = .false.
    rescale_density = .false.
    number_density_rescale = 1d-6
    ion_flr_scale_factor = 1.0
/

! Required even when type_of_run is not 'WKB_dispersion'.
&wkb_dispersion
/

&kim_io
    profile_location = './profiles/'       ! must end with '/'
    output_path = './out/'                 ! results go to out/m<m>_n<n>/
    hdf5_input = .false.
    hdf5_output = .true.
    h5_out_file = 'KIM_out.h5'
    log_level = 1
    data_verbosity = 0
    calculate_asymptotics = .true.
/

&kim_setup
    btor = -17977.413                      ! toroidal field on axis [G]
    r0 = 165.0                             ! major radius [cm]
    m_mode = -6                            ! poloidal mode number
    n_mode = 2                             ! toroidal mode number
    omega = 0.0                            ! perturbation frequency [rad/s]
    spline_base = 1
    type_br_field = 12
    collisions_off = .false.
    set_profiles_constant = 0
    bc_type = 3
    mphi_max = 0
/

&kim_grid
    r_min = 11.0                           ! inner boundary [cm]
    r_plas = 39.0                          ! outer boundary [cm]
    width_res = 0.5
    ampl_res = 15.0
    hrmax_scaling = 1.0
    l_space_dim = 32                       ! field grid points
    rg_space_dim = 32                      ! guiding-centre grid points
    grid_spacing_rg = "equidistant"
    grid_spacing_xl = "equidistant"
    theta_integration = "GaussLegendre"
    rkf45_atol = 1.0d-9
    rkf45_rtol = 1.0d-6
    quadpack_algorithm = 'QAG'
    quadpack_key = 6
    quadpack_limit = 500
    quadpack_epsabs = 1.0d-10
    quadpack_epsrel = 1.0d-10
    quadpack_use_u_substitution = .true.
    kernel_taper_skip_threshold = 1.0d-6
    Larmor_skip_factor = 5
    gauss_int_nodes_Nx = 8
    gauss_int_nodes_Nxp = 7
    gauss_int_nodes_Ntheta = 8
/

&kim_profiles
    coord_type = 'r_eff'                   ! profiles are given in effective radius [cm]
    input_profile_dir = './profiles/'
    equil_file = ''
    geqdsk_file = ''
    n_input_file = 'n_of_psiN.dat'
    Te_input_file = 'Te_of_psiN.dat'
    Ti_input_file = 'Ti_of_psiN.dat'
    Vz_input_file = 'Vz_of_psiN.dat'
    n_file = 'n.dat'
    Te_file = 'Te.dat'
    Ti_file = 'Ti.dat'
    Vz_file = 'Vz.dat'
    Er_file = 'Er.dat'
    q_file = 'q.dat'
/
